ig block to `ace.artifacts.stitches`, each [/#D7D7AF]\n    [#D7D7AF]with a deprecated legacy name that still loads and warns.[/#D7D7AF]\n    [#D7D7AF][/#D7D7AF]\n[dim]  4 [bold #AF87FF][/dim]◆ [bold #D7AFFF][/bold #AF87FF]Flip user-visible Commits text to Stitches and refresh [/bold #D7AFFF]       [bold black on #FFD75F] medium [/bold black on #FFD75F]\n      [bold #D7AFFF]snapshots[/bold #D7AFFF]\n    [#AF87FF]labels[dim] · [dim][/dim]after config-keys[/#AF87FF][/dim]\n    [#D7D7AF]labels: change every displayed \"Commits\" string that names the Artifacts[/#D7D7AF]\n    [#D7D7AF]pane to \"Stitches\" — tab strip, pane chip, placeholder copy, quickstart,[/#D7D7AF]\n    [#D7D7AF]help modal, command palette, footer — then update docs and regenerate [/#D7D7AF]\n    [#D7D7AF]the affected text and PNG snapshot goldens.[/#D7D7AF]","clan_tribe":"epic","epic_bead_id":"sase-j8","llm_provider":"codex","model":"gpt-5.5","patch_name":"gh_sase-org__sase","phase_bead_id":"sase-j8.1","reasoning_effort":"xhigh","vcs_provider":"GitHub"},"source_run_id":"run-baf3cc7f70d7f684dfef266eb206d748","started_at":"2026-08-10T20:23:10.504180+00:00","state":"completed"},{"commits":[{"committed_at":1786398424,"sha":"c69d16378ce32661565654463c19f8dd03c2ac76","subject":"refactor(ace): rename Artifacts commits sub-tab identifier to stitches"}],"dismissed_at":null,"files":{"chat":{"digest":"e380bf9caadd481b4d9f7e9c8b6696ae86aabc720e4e74ab8b1b1b3eef59aba9","path":"agents/bbugyi200.athena.sase-j8.2/chat.md","size_bytes":13580},"commits":{"digest":"2ace09efdcb8e54c6173b37b3d22faba37b8c2dbc6345425034e1b0dd23a2b57","path":"agents/bbugyi200.athena.sase-j8.2/commits.json","size_bytes":248},"embedded_workflows":{"digest":"a398c70160fe308637edd70b38d8cf02cc697183c480675d10f387d529663058","path":"agents/bbugyi200.athena.sase-j8.2/embedded_workflows.json","size_bytes":80},"meta":{"digest":"bb7b849da55177bda29fc1d8570763b9aba5bb5e8a74690c59a963f83741537e","path":"agents/bbugyi200.athena.sase-j8.2/meta.json","siz