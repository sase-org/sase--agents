n #FFD75F] medium [/bold black on #FFD75F]\n      [bold #D7AFFF]surfacing[/bold #D7AFFF]\n    [#AF87FF]verify-on-athena[dim] · [dim][/dim]after by-status-incremental, stale-process-restart[/#AF87FF][/dim]\n    [#D7D7AF]verify-on-athena: restart the athena TUI onto the fixed tree, soak under[/#D7D7AF]\n    [#D7D7AF]BY_STATUS grouping with live churn proving `@epic` stays mounted with no[/#D7D7AF]\n    [#D7D7AF]steady-state unsupported_grouping fallbacks, script a checkout-advance [/#D7D7AF]\n    [#D7D7AF]to prove the staleness indicator fires and clears through a restart, and[/#D7D7AF]\n    [#D7D7AF]add a regression guard against silent full-rebuild reintroduction.[/#D7D7AF]","clan_tribe":"epic","epic_bead_id":"sase-12p","llm_provider":"codex","model":"gpt-5.5","patch_name":"gh_sase-org__sase","phase_bead_id":"sase-12p.1","reasoning_effort":"xhigh","vcs_provider":"GitHub"},"source_run_id":"run-60c48aa96240940e42f09a23b66c1dcb","started_at":"2026-09-18T11:04:40.543229+00:00","state":"active"},{"capabilities":{"durably_revivable":true,"historically_viewable":true,"missing_requirements":[],"restartable":true},"commits":[],"dismissed_at":null,"files":{"chat":{"digest":"f7c3e07b14d94cba76bd3b0e683e5d44cd388b6fff42534bbbf8ce8916952e47","path":"agents/bbugyi200.athena.sase-12p.3--plan/chat.md","size_bytes":5607},"commits":{"digest":"654085495870d572bfdd0b1ad778245533731b5e1c3f9ef60f7761f437285357","path":"agents/bbugyi200.athena.sase-12p.3--plan/commits.json","size_bytes":89},"embedded_workflows":{"digest":"a398c70160fe308637edd70b38d8cf02cc697183c480675d10f387d529663058","path":"agents/bbugyi200.athena.sase-12p.3--plan/embedded_workflows.json","size_bytes":80},"meta":{"digest":"6ddc5d9f5c9e557abbe5c033d1afafb92dd8ef9742351f5190d9f9c2b5ce25b6","path":"agents/bbugyi200.athena.sase-12p.3--plan/meta.json","size_bytes":803},"prompt":{"digest":"2fa869d27dd7b5383fa1c9eb7ded634a5a7ece469bd573e014482a04b20ce337","path":"agents/bbugyi200.athena.sase-12p.3--plan/prompt.md","size_byte