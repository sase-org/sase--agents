"agents/bbugyi200.athena.sase-ng.1.1--plan/meta.json","size_bytes":5982},"prompt":{"digest":"7c06eb9f37b9471673f92f52cd6ff00dad36cf90e55073542f7e335ad981e2a8","path":"agents/bbugyi200.athena.sase-ng.1.1--plan/prompt.md","size_bytes":177},"prompt_steps":{"digest":"3ae0e8b3c1726a451d4d6537f5ca9855c3d85b2ab3e817d3c1e91b9708effa64","path":"agents/bbugyi200.athena.sase-ng.1.1--plan/prompt_steps.json","size_bytes":5471},"state":{"digest":"63b8f853b8703189aa2af38cbe7d071b110d73acaa70ad07c882a6882f9baf01","path":"agents/bbugyi200.athena.sase-ng.1.1--plan/state.json","size_bytes":183}},"finished_at":null,"global_name":"bbugyi200.athena.sase-ng.1.1--plan","local_name":"sase-ng.1.1--plan","metadata":{"agent_clan":"sase-ng.1","agent_clan_generation":"20260817151740","agent_family":"sase-ng.1.1","agent_family_role":"plan","approve":true,"bead_id":"sase-ng.1.1","changespec_name":"gh_sase-org__sase","cl_name":"gh_sase-org__sase","clan_summary":"[bold #D75FFF]◆ EPIC sase-ng.1[/bold #D75FFF]\n[dim]  Title: [bold #D7AFFF][/dim]Retire dead ACE in-process launch and cleanup bodies[/bold #D7AFFF]\n[dim]   Goal: [#D7D7AF][/dim]ACE's launch and cleanup procs have exactly one implementation each[/#D7D7AF]\n[dim]         [#D7D7AF][/dim]— the durable argv path production actually runs — with no orphaned[/#D7D7AF]\n[dim]         [#D7D7AF][/dim]in-process body family, no vestigial `proc_callable` parameters, no[/#D7D7AF]\n[dim]         [#D7D7AF][/dim]test double that reaches a code path production cannot reach, and [/#D7D7AF]\n[dim]         [#D7D7AF][/dim]no user-facing capability silently dropped on the way.[/#D7D7AF]\n[dim] Counts: [bold #D7AFFF][/dim]6[dim][/bold #D7AFFF] phases[dim][/dim] · [bold #D7AFFF][/dim]4[dim][/bold #D7AFFF] waves[/dim]\n[dim]   Path: [#87AFFF][/dim]plan:202608/[bold #87AFFF][/#87AFFF]retire_dead_ace_launch_cleanup_bodies.md[/bold #87AFFF]\n[dim] Prompt: [#87AFFF][/dim]prompts/202608/retire_dead_ace_launch_cleanup_bodies.md[/#87AFFF]\n[dim]   Bead: [#87AFFF][/dim]sase-ng.1[/#87AFFF]\n[dim]   Page: [#87AFFF][/dim]https://github.com/sase-org/sase--beads/blob/main/pages/sase-ng/[bold #87AFFF][/#87AFFF]sase-ng.1.md[/bold #87AFFF]\n[dim]  1 [bold #AF87FF][/dim]◆ [bold #D7AFFF][/bold #AF87FF]Restore forced name reuse on the durable launch path[/bold #D7AFFF]          [bold black on #FFD75F] medium [/bold black on #FFD75F]\n    [#AF87FF]force_reuse[dim] · [dim][/dim]no dependencies[/#AF87FF][/dim]\n    [#D7D7AF]force_reuse: extract the `%id:!name` force-reuse launch pipeline out of [/#D7D7AF]\n    [#D7D7AF]the orphaned TUI body into a shared `sase.agent.force_reuse_launch` [/#D7D7AF]\n    [#D7D7AF]module, carry ACE's confirmation through the `RUN_LAUNCH` request [/#D7D7AF]\n    [#D7D7AF]payload, and consume it in the `sase run` child so kill-and-edit [/#D7D7AF]\n    [#D7D7AF]relaunches work again before the orphaned copy is deleted.[/#D7D7AF]\n    [#D7D7AF][/#D7D7AF]\n[dim]  2 [bold #AF87FF][/dim]◆ [bold #D7AFFF][/bold #AF87FF]Restore MRU and unresolved-reference feedback on the durable [/bold #D7AFFF] [bold black on #87D7FF] small  [/bold black on #87D7FF]\n      [bold #D7AFFF]launch path[/bold #D7AFFF]\n    [#AF87FF]feedback[dim] · [dim][/dim]no dependencies[/#AF87FF][/dim]\n    [#D7D7AF]feedback: move VCS-xprompt MRU recording and the [/#D7D7AF]\n    [#D7D7AF]unresolved-xprompt-reference warning toast onto the durable path, so [/#D7D7AF]\n    [#D7D7AF]`<ctrl+p>` cycling keeps being fed and ACE keeps warning about unknown [/#D7D7AF]\n    [#D7D7AF]`#refs` once the orphaned body is deleted.[/#D7D7AF]\n    [#D7D7AF][/#D7D7AF]\n[dim]  3 [bold #AF87FF][/dim]◆ [bold #D7AFFF][/bold #AF87FF]Retire the cleanup worker bodies and their proc_callable seam[/bold #D7AFFF] [bold black on #FFD75F] medium [/bold black on #FFD75F]\n    [#AF87FF]cleanup_retire[dim] · [dim][/dim]no dependencies[/#AF87FF][/dim]\n    [#D7D7AF]cleanup_retire: delete the dead `_worker` closures behind kill, dismiss,[/#D7D7AF]\n    [#D7D7AF]and save persistence, drop `proc_callable` from `_submit_cleanup_proc`, [/#D7D7AF]\n    [#D7D7AF]and re-point the shared cleanup test harness at the durable [/#D7D7AF]\n    [#D7D7AF]persist-cleanup payload seam.[/#D7D7AF]\n    [#D7D7AF][/#D7D7AF]\n[dim]  4 [bold #AF87FF][/dim]◆ [bold #D7AFFF][/bold #AF87FF]Retire the in-process launch body and fan-out dispatchers[/bold #D7AFFF]     [bold black on #FFD75F] medium [/bold black on #FFD75F]\n    [#AF87FF]launch_retire[dim] · [dim][/dim]after force_reuse, feedback[/#AF87FF][/dim]\n    [#D7D7AF]launch_retire: delete `run_agent_launch_body`, [/#D7D7AF]\n    [#D7D7AF]`run_single_agent_launch_body`, the four fan-out dispatcher mixins, and [/#D7D7AF]\n    [#D7D7AF]`proc_callable` on `_submit_launch_proc`, then delete or re-point every [/#D7D7AF]\n    [#D7D7AF]test that reached them through the discarded callable.[/#D7D7AF]\n    [#D7D7AF][/#D7D7AF]\n[dim]  5 [bold #AF87FF][/dim]◆ [bold #D7AFFF][/bold #AF87FF]Retire the launch-body support modules the deletion orphans[/bold #D7AFFF]   [bold black on #FFD75F] medium [/bold black on #FFD75F]\n    [#AF87FF]support_retire[dim] · [dim][/dim]after launch_retire[/#AF87FF][/dim]\n    [#D7D7AF]support_retire: delete the second-order orphans the body deletion leaves[/#D7D7AF]\n    [#D7D7AF]behind — the background-spawn bridge, launch-history helpers, TUI [/#D7D7AF]\n    [#D7D7AF]workflow executor, and the ref-resolution mixin — resolving each against[/#D7D7AF]\n    [#D7D7AF]symvision rather than by assumption.[/#D7D7AF]\n    [#D7D7AF][/#D7D7AF]\n[dim]  6 [bold #AF87FF][/dim]◆ [bold #D7AFFF][/bold #AF87FF]Final orphan sweep, full verification, and follow-ups[/bold #D7AFFF]         [bold black on #87D7FF] small  [/bold black on #87D7FF]\n    [#AF87FF]sweep[dim] · [dim][/dim]after cleanup_retire, support_retire[/#AF87FF][/dim]\n    [#D7D7AF]sweep: re-run the whole-repo lint and full test suite, resolve any [/#D7D7AF]\n    [#D7D7AF]remaining orphan reported by symvision, and file the follow-up beads for[/#D7D7AF]\n    [#D7