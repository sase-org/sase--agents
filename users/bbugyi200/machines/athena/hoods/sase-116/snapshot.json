.[/#D7D7AF]\n[dim]  4 [bold #AF87FF][/dim]◆ [bold #D7AFFF][/bold #AF87FF]Route work launches, pages, and epic symbol checks[/bold #D7AFFF]            [bold black on #FFD75F] medium [/bold black on #FFD75F]\n    [#AF87FF]work-and-pages[dim] · [dim][/dim]after operation-context[/#AF87FF][/dim]\n    [#D7D7AF]work-and-pages: propagate the owning project through bead work and [/#D7D7AF]\n    [#D7D7AF]parent overrides, page operations, and epic-symbol discovery; verify [/#D7D7AF]\n    [#D7D7AF]launch and projection behavior with isolated fixtures.[/#D7D7AF]","clan_tribe":"epic","epic_bead_id":"sase-116","llm_provider":"codex","model":"gpt-5.5","patch_name":"gh_sase-org__sase","phase_bead_id":"sase-116.1","reasoning_effort":"xhigh","vcs_provider":"GitHub"},"source_run_id":"run-613569d082d829c44ea981f78e1e5883","started_at":"2026-09-15T13:05:13.619662+00:00","state":"active"},{"capabilities":{"durably_revivable":true,"historically_viewable":true,"missing_requirements":[],"restartable":true},"commits":[{"committed_at":1789499973,"sha":"39a084fc461a24cec532ad793486a82a517ea10e","subject":"test(bead): expand command routing acceptance"}],"dismissed_at":null,"files":{"chat":{"digest":"04f07435fd21eb535ad3eeda95a24fe70cec57ac769bf7df40d86599c42152b9","path":"agents/bbugyi200.athena.sase-116.5.2/chat.md","size_bytes":22243},"commits":{"digest":"ca7d8739d499c2c3a0d285954bbed48b2187be6b2246843fb980e23fc200a369","path":"agents/bbugyi200.athena.sase-116.5.2/commits.json","size_bytes":223},"embedded_workflows":{"digest":"a398c70160fe308637edd70b38d8cf02cc697183c480675d10f387d529663058","path":"agents/bbugyi200.athena.sase-116.5.2/embedded_workflows.json","size_bytes":80},"meta":{"digest":"a23c8062aa3ad79c82ecef09340c671696260f749767f12b692e45db44bc2b95","path":"agents/bbugyi200.athena.sase-116.5.2/meta.json","size_bytes":685},"prompt":{"digest":"08625a6ba7256d57334db298bf13a79f479a58181b01f539a99c37021529af8d","path":"agents/bbugyi200.athena.sase-116.5.2/prompt.md","size_bytes":156},"