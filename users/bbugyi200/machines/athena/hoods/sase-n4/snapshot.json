ents/bbugyi200.athena.sase-n4.1/prompt.md","size_bytes":169},"prompt_steps":{"digest":"c9a2ee08537eb4ece8b25b205985dcf6cde27273c80e7897435bce2964237b99","path":"agents/bbugyi200.athena.sase-n4.1/prompt_steps.json","size_bytes":15180},"state":{"digest":"d514cbf43454cbb5a03bc1eccb853ad20782be0a14d940f8e397d022ead16ad6","path":"agents/bbugyi200.athena.sase-n4.1/state.json","size_bytes":183}},"finished_at":null,"global_name":"bbugyi200.athena.sase-n4.1","local_name":"sase-n4.1","metadata":{"agent_clan":"sase-n4","agent_clan_generation":"20260816103728","approve":true,"bead_id":"sase-n4.1","changespec_name":"gh_sase-org__sase","cl_name":"gh_sase-org__sase","clan_summary":"[bold #D75FFF]◆ EPIC sase-n4[/bold #D75FFF]\n[dim]  Title: [bold #D7AFFF][/dim]Auto-disable LLM providers on usage-limit errors[/bold #D7AFFF]\n[dim]   Goal: [#D7D7AF][/dim]When a sase agent fails because its LLM provider reported a [/#D7D7AF]\n[dim]         [#D7D7AF][/dim]usage/quota limit, sase recognizes that failure, temporarily [/#D7D7AF]\n[dim]         [#D7D7AF][/dim]disables just that provider (honoring the reset time the provider [/#D7D7AF]\n[dim]         [#D7D7AF][/dim]itself reported when one is available), stops wasting retries on [/#D7D7AF]\n[dim]         [#D7D7AF][/dim]it, and tells the user what happened with a rich notification. [/#D7D7AF]\n[dim]         [#D7D7AF][/dim]Defaults work out of the box for every shipped provider, and users [/#D7D7AF]\n[dim]         [#D7D7AF][/dim]can extend or replace the patterns and durations from config.[/#D7D7AF]\n[dim] Counts: [bold #D7AFFF][/dim]4[dim][/bold #D7AFFF] phases[dim][/dim] · [bold #D7AFFF][/dim]3[dim][/bold #D7AFFF] waves[/dim]\n[dim]   Path: [#87AFFF][/dim]plan:202608/[bold #87AFFF][/#87AFFF]llm_usage_limit_auto_disable.md[/bold #87AFFF]\n[dim] Prompt: [#87AFFF][/dim]prompts/202608/llm_usage_limit_auto_disable.md[/#87AFFF]\n[dim]   Bead: [#87AFFF][/dim]sase-n4[/#87AFFF]\n[dim]   Page: [#87AFFF][/dim]https://github.com/sase-org/sase--beads/blob/main/pages/sase-n4/[bold #87AFFF][/#87AFFF]README.md[/bold #87AFFF]\n[dim]  1 [bold #AF87FF][/dim]◆ [bold #D7AFFF][/bold #AF87FF]Usage-limit detection core[/bold #D7AFFF]                                    [bold black on #FFD75F] medium [/bold black on #FFD75F]\n    [#AF87FF]detect[dim] · [dim][/dim]no dependencies[/#AF87FF][/dim]\n    [#D7D7AF]detect: add the `llm_provider.usage_limit` config section, its JSON [/#D7D7AF]\n    [#D7D7AF]schema, the `llm_default_usage_limit_config` plugin hook, evidence-based[/#D7D7AF]\n    [#D7D7AF]built-in patterns for every shipped provider, and the [/#D7D7AF]\n    [#D7D7AF]normalize/match/exclude plus reset-hint parsing logic, with a regression[/#D7D7AF]\n    [#D7D7AF]corpus of real captured provider messages.[/#D7D7AF]\n    [#D7D7AF][/#D7D7AF]\n[dim]  2 [bold #AF87FF][/dim]◆ [bold #D7AFFF][/bold #AF87FF]Runtime disable and retry precedence[/bold #D7AFFF]                          [bold black on #FFD75F] medium [/bold black on #FFD75F]\n    [#AF87FF]enforce[dim] · [dim][/dim]after detect[/#AF87FF][/dim]\n    [#D7D7AF]enforce: call detection from the LLM invocation error paths, write the [/#D7D7AF]\n    [#D7D7AF]temporary provider disable through the existing Rust-backed store with a[/#D7D7AF]\n    [#D7D7AF]structured source, make a usage-limit failure take precedence over the [/#D7D7AF]\n    [#D7D7AF]retry loop so agents stop sleeping through futile waits, and record [/#D7D7AF]\n    [#D7D7AF]telemetry.[/#D7D7AF]\n    [#D7D7AF][/#D7D7AF]\n[dim]  3 [bold #AF87FF][/dim]◆ [bold #D7AFFF][/bold #AF87FF]Rich usage-limit notification[/bold #D7AFFF]                                 [bold black on #87D7FF] small  [/bold black on #87D7FF]\n    [#AF87FF]notify[dim] · [dim][/dim]after enforce[/#AF87FF][/dim]\n    [#D7D7AF]notify: add a notification sender that reports which provider was [/#D7D7AF]\n    [#D7D7AF]disabled, for how long and until when, what the provider actually said, [/#D7D7AF]\n    [#D7D7AF]and which agent tripped it, with once-per-disable-window dedup.[/#D7D7AF]\n    [#D7D7AF][/#D7D7AF]\n[dim]  4 [bold #AF87FF][/dim]◆ [bold #D7AFFF][/bold #AF87FF]Surface the disable reason and document the feature[/bold #D7AFFF]           [bold black on #87D7FF] small  [/bold black on #87D7FF]\n    [#AF87FF]surface[dim] · [dim][/dim]after enforce[/#AF87FF][/dim]\n    [#D7D7AF]surface: render automatic versus manual provenance in the Models panel [/#D7D7AF]\n    [#D7D7AF]and the top-bar provider-disable indicator, and document the new config [/#D7D7AF]\n    [#D7D7AF]section in the default config and user docs.[/#D7D7AF]","clan_tribe":"epic","epic_bead_id":"sase-n4","llm_provider":"claude","model":"sonnet","patch_name":"gh_sase-org__sase","phase_bead_id":"sase-n4.1","reasoning_effort":"xhigh","vcs_provider":"GitHub"},"source_run_id":"run-1d3236127b29d36aba22206933685800","started_at":"2026-08-16T14:37:49.164701+00:00","state":"completed"},{"commits":[{"committed_at":1786897494,"sha":"c9ef675105258e853f80629628c6826f9ad33fe2","subject":"feat(llm-provider): auto-disable providers on usage-limit errors"}],"dismissed_at":null,"files":{"chat":{"digest":"805f1b4bdb66fa95305ee2c3a4a49a388174737d0d77ed4cc71fc3c75bfe4365","path":"agents/bbugyi200.athena.sase-n4.2/chat.md","size_bytes":9789},"commits":{"digest":"a66c672c0b1742fb332ce26cc794e08d2baa7e0abadf6eb784ace8f8fedc177b","path":"agents/bbugyi200.athena.sase-n4.2/commits.json","size_bytes":242},"embedded_workflows":{"digest":"a398c70160fe308637edd70b38d8cf02cc697183c480675d10f387d529663058","path":"agents/bbugyi200.athena.sase-n4.2/embedded_workflows.json","size_bytes":80},"meta":{"digest":"eeecb0a8fa4c03a4a2fd148c2e4a65d516e1b58ff90de54a350c34adcc18998b","path":"agents/bbugyi200.athena.sase-n4.2/meta.json","size_bytes":633},"prompt":{"digest":"4aae520be7b18aabb6d01a28f77b52f75f28db853ca608201bdb66a9c65c148c","path":"agents/bbugyi200.athena.sase-n4.2/prompt.md","size_bytes":141},"prompt_steps":{"digest":"ab0f398ffa1613a2deb3726a44fa3d585eb4bc7527dd14ddddb30051