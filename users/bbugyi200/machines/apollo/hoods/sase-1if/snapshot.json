o.sase-1if.1/embedded_workflows.json","size_bytes":80},"meta":{"digest":"6ec45c551b1936590d4a5f3b07078065b4eb2a029689e1fccfa2305c64d33b72","path":"agents/bbugyi200.apollo.sase-1if.1/meta.json","size_bytes":8053},"prompt":{"digest":"0b65baa056fda6152caf6a76e9beb3475d73fa9913fde988a09e19402a0e7114","path":"agents/bbugyi200.apollo.sase-1if.1/prompt.md","size_bytes":173},"prompt_steps":{"digest":"c3cd5665fde0c0d69c9c44bc7c2998a6e4478bba864417b4165905d7b3fb4994","path":"agents/bbugyi200.apollo.sase-1if.1/prompt_steps.json","size_bytes":7370},"state":{"digest":"0dfee00c4f413a395a66a987d38202e2b7dee42feea0a26a5e69cc28c837263c","path":"agents/bbugyi200.apollo.sase-1if.1/state.json","size_bytes":213}},"finished_at":"2026-10-08T20:53:34.373221+00:00","global_name":"bbugyi200.apollo.sase-1if.1","local_name":"sase-1if.1","metadata":{"agent_clan":"sase-1if","agent_clan_generation":"20261008152717","approve":true,"bead_id":"sase-1if.1","changespec_name":"gh_sase-org__sase","cl_name":"gh_sase-org__sase","clan_summary":"[bold #D75FFF]◆ EPIC sase-1if[/bold #D75FFF]\n[dim]  Title: [bold #D7AFFF][/dim]Plugin commands — sase listen as the first first-class command [/bold #D7AFFF]\n[dim]         [bold #D7AFFF][/dim]plugin[/bold #D7AFFF]\n[dim]   Goal: [#D7D7AF][/dim]Plugins can mount top-level `sase <name>` commands through a [/#D7D7AF]\n[dim]         [#D7D7AF][/dim]metadata-declared `sase_commands` entry point. sase-listen uses it [/#D7D7AF]\n[dim]         [#D7D7AF][/dim]to ship `sase listen`, which behaves exactly like `sase-listen`, [/#D7D7AF]\n[dim]         [#D7D7AF][/dim]completes in bash/zsh/fish and the TUI `:` line, refreshes [/#D7D7AF]\n[dim]         [#D7D7AF][/dim]completion automatically on every plugin change, and is installed [/#D7D7AF]\n[dim]         [#D7D7AF][/dim]and managed from the Admin Center's Updates tab. Every moment a [/#D7D7AF]\n[dim]         [#D7D7AF][/dim]plugin adds or removes a command is announced clearly and [/#D7D7AF]\n[dim]         [#D7D7AF][/dim]consistently.[/#D7D7AF]\n[dim] Counts: [bold #D7AFFF][/dim]10[dim][/bold #D7AFFF] phases[dim][/dim] · [bold #D7AFFF][/dim]6[dim][/bold #D7AFFF] waves[/dim]\n[dim]   Path: [#87AFFF][/dim]plan:202610/[bold #87AFFF][/#87AFFF]plugin_commands.md[/bold #87AFFF]\n[dim] Prompt: [#87AFFF][/dim]prompts/202610/plugin_commands.md[/#87AFFF]\n[dim]   Bead: [#87AFFF][/dim]sase-1if[/#87AFFF]\n[dim]   Page: [#87AFFF][/dim]https://github.com/sase-org/sase--beads/blob/main/pages/sase-1if/[bold #87AFFF][/#87AFFF]README.md[/bold #87AFFF]\n[dim]  1 [bold #AF87FF][/dim]◆ [bold #D7AFFF][/bold #AF87FF]Plugin command contract, discovery, and dispatch[/bold #D7AFFF]              [bold black on #FFD75F] medium [/bold black on #FFD75F]\n    [#AF87FF]mount[dim] · [dim][/dim]no dependencies[/#AF87FF][/dim]\n    [#D7D7AF]mount: add the generic sase_commands contract, metadata-only discovery [/#D7D7AF]\n    [#D7D7AF]and validation, the pre-argparse dispatch fast path, helpful misses, the[/#D7D7AF]\n    [#D7D7AF]shared command chip, a fake-distribution test harness, and the hermetic [/#D7D7AF]\n    [#D7D7AF]test guard.[/#D7D7AF]\n    [#D7D7AF][/#D7D7AF]\n[dim]  2 [bold #AF87FF][/dim]◆ [bold #D7AFFF][/bold #AF87FF]sase-listen becomes a command plugin[/bold #D7AFFF]                          [bold black on #FFD75F] medium [/bold black on #FFD75F]\n    [#AF87FF]listen-adapter[dim] · [dim][/dim]no dependencies[/#AF87FF][/dim]\n    [#D7D7AF]listen-adapter: in the sase-listen repo, add the sase_command adapter [/#D7D7AF]\n    [#D7D7AF]and entry point, thread the program name through the CLI and hints, fix [/#D7D7AF]\n    [#D7D7AF]buildinfo and the feed-host remote command for plugin-only hosts, and [/#D7D7AF]\n    [#D7D7AF]rewrite the standalone stance.[/#D7D7AF]\n    [#D7D7AF][/#D7D7AF]\n[dim]  3 [bold #AF87FF][/dim]◆ [bold #D7AFFF][/bold #AF87FF]Plugin commands in root help and sase doctor[/bold #D7AFFF]                  [bold black on #87D7FF] small  [/bold black on #87D7FF]\n    [#AF87FF]help-doctor[dim] · [dim][/dim]after mount[/#AF87FF][/dim]\n    [#D7D7AF]help-doctor: list plugin commands in sase -H (and sase -h per decision) [/#D7D7AF]\n    [#D7D7AF]with provenance and problem states, and add the plugins.commands doctor [/#D7D7AF]\n    [#D7D7AF]check.[/#D7D7AF]\n    [#D7D7AF][/#D7D7AF]\n[dim]  4 [bold #AF87FF][/dim]◆ [bold #D7AFFF][/bold #AF87FF]Plugin subtrees in completion with plugin-aware cache identity[bold black on #FFD75F][/bold #D7AFFF] medium [/bold black on #FFD75F]\n    [#AF87FF]completion[dim] · [dim][/dim]after mount[/#AF87FF][/dim]\n    [#D7D7AF]completion: merge separately walked plugin parsers into a runtime [/#D7D7AF]\n    [#D7D7AF]completion spec, make the grammar and TUI spec caches key on the plugin [/#D7D7AF]\n    [#D7D7AF]command set and editable sources, and record omitted subtrees.[/#D7D7AF]\n    [#D7D7AF][/#D7D7AF]\n[dim]  5 [bold #AF87FF][/dim]◆ [bold #D7AFFF][/bold #AF87FF]Command-aware plugin install, update, and uninstall[/bold #D7AFFF]           [bold black on #FFD75F] medium [/bold black on #FFD75F]\n    [#AF87FF]lifecycle[dim] · [dim][/dim]after mount, completion[/#AF87FF][/dim]\n    [#D7D7AF]lifecycle: fix the inventory groups, carry command names in the [/#D7D7AF]\n    [#D7D7AF]installed index, diff the command set around every plugin mutation, [/#D7D7AF]\n    [#D7D7AF]refresh completion in a fresh child process, and announce added or [/#D7D7AF]\n    [#D7D7AF]removed commands in CLI results and JSON.[/#D7D7AF]\n    [#D7D7AF][/#D7D7AF]\n[dim]  6 [bold #AF87FF][/dim]◆ [bold #D7AFFF][/bold #AF87FF]Pre-install command preview[/bold #D7AFFF]                                   [bold black on #87D7FF] small  [/bold black on #87D7FF]\n    [#AF87FF]command-preview[dim] · [dim][/dim]after lifecycle[/#AF87FF][/dim]\n    [#D7D7AF]command-preview: read an uninstalled plugin's declared sase_commands [/#D7D7AF]\n    [#D7D7AF]from its upstream pyproject.toml with a cache, expose it in plugin JSON [/#D7D7AF]\n    [#D7D7AF]and the install dry run, and flag collisions before install.[/#D7D7AF]\n    [#D7D7AF][/#D7D7AF]\n[dim]  7 [bold #AF87FF][/dim]◆ [bold #D7AFFF][/bold #AF87FF]Commands in the Updates tab and plugin detail[/bold #D7AFFF]                 [bold black on #FFD75F] medium [/bold black on #FFD75F]\n    [#AF87FF]updates-tab[dim] · [dim][/dim]after command-preview[/#AF87FF][/dim]\n    [#D7D7AF]updates-tab: render the command chip in Updates rows, the shared detail [/#D7D7AF]\n    [#D7D7AF]panel, install and uninstall confirmations, and the post-install toast [/#D7D7AF]\n    [#D7D7AF]receipt, then refresh the affected PNG goldens.[/#D7D7AF]\n    [#D7D7AF][/#D7D7AF]\n[dim]  8 [bold #AF87FF][/dim]◆ [bold #D7AFFF][/bold #AF87FF]Lazy sase-listen command imports[/bold #D7AFFF]                              [bold black on #87D7FF] small  [/bold black on #87D7FF]\n    [#AF87FF]listen-fast-start[dim] · [dim][/dim]after listen-adapter[/#AF87FF][/dim]\n    [#D7D7AF]listen-fast-start: in the sase-listen repo, defer heavy imports into [/#D7D7AF]\n    [#D7D7AF]command handlers so building the parser and rendering help stay fast, [/#D7D7AF]\n    [#D7D7AF]guarded by an import-isolation test.[/#D7D7AF]\n    [#D7D7AF][/#D7D7AF]\n[dim]  9 [bold #AF87FF][/dim]◆ [bold #D7AFFF][/bold #AF87FF]Research macros prefer sase listen[/bold #D7AFFF]                            [bold black on #87D7FF] small  [/bold black on #87D7FF]\n    [#AF87FF]research-macros[dim] · [dim][/dim]after listen-adapter[/#AF87FF][/dim]\n    [#D7D7AF]research-macros: in the sase-research-artifacts repo, make the audio [/#D7D7AF]\n    [#D7D7AF]macros select sase listen first, then sase-listen, then uvx sase-listen,[/#D7D7AF]\n    [#D7D7AF]and update docs and pinned-string tests.[/#D7D7AF]\n    [#D7D7AF][/#D7D7AF]\n[dim]  10 [bold #AF87FF][/dim]◆ [bold #D7AFFF][/bold #AF87FF]End-to-end acceptance, records, and docs[/bold #D7AFFF]                     [bold black on #FFD75F] medium [/bold black on #FFD75F]\n    [#AF87FF]acceptance[dim] · [dim][/dim]after help-do